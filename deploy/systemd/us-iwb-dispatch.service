[Unit]
Description=Dispatch the US IWB close report on GitHub Actions
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
NoNewPrivileges=yes
EnvironmentFile=/etc/us-iwb-dispatch/github-app.env
LoadCredential=github-app-key:/etc/us-iwb-dispatch/github-app.pem
ExecStart=/usr/bin/python3 /usr/local/lib/us-iwb-dispatch/github_dispatch.py
TimeoutStartSec=50s
